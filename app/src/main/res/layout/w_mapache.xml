<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_raiz" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/wf_mapache">
  <include layout="@layout/w_rac" android:layout_width="120dp" android:layout_height="120dp" android:layout_marginStart="10dp" android:layout_marginTop="4dp" />
  <TextView android:id="@+id/w_zz" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end" android:layout_marginTop="12dp" android:layout_marginEnd="16dp" android:text="zZ" android:textColor="#FFA9C3D6" android:textSize="18sp" android:textStyle="bold" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="10dp" android:paddingBottom="10dp">
    <TextView android:id="@+id/w_titulo" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#FFFEF1D5" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text="En pausa" />
    <ImageButton android:id="@+id/w_alternar" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/wc_arena" android:padding="11dp" android:scaleType="fitCenter" android:src="@drawable/wi_play" android:tint="#FF0C324A" android:contentDescription="Reproducir o pausar" />
  </LinearLayout>
</FrameLayout>
