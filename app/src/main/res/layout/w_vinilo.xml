<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_raiz" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/wf_marina" android:orientation="horizontal" android:padding="14dp">
  <FrameLayout android:layout_width="150dp" android:layout_height="match_parent">
    <ImageView android:id="@+id/w_vinilo_quieto" android:layout_width="140dp" android:layout_height="140dp" android:layout_gravity="center_vertical" android:src="@drawable/vinilo_00" android:importantForAccessibility="no" />
    <ViewFlipper android:id="@+id/w_vinilo" android:layout_width="140dp" android:layout_height="140dp" android:layout_gravity="center_vertical" android:autoStart="true" android:flipInterval="120" android:animateFirstView="false" android:inAnimation="@anim/w_entra_vinilo" android:outAnimation="@anim/w_sale_vinilo" android:visibility="gone">
      <include layout="@layout/w_vinilo_cuadros" />
    </ViewFlipper>
    <ImageView android:id="@+id/w_portada" android:layout_width="58dp" android:layout_height="58dp" android:layout_marginStart="41dp" android:layout_gravity="center_vertical" android:src="@drawable/wc_rojo" android:importantForAccessibility="no" />
    <include layout="@layout/w_rac" android:layout_width="64dp" android:layout_height="64dp" android:layout_gravity="bottom|end" />
  </FrameLayout>
  <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
    <TextView android:id="@+id/w_titulo" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFEF1D5" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text="Nada sonando"  />
    <TextView android:id="@+id/w_autor" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFA9C3D6" android:textSize="13sp"  android:maxLines="1" android:ellipsize="end" android:text="Toca para abrir RACQ"  />
    <TextView android:id="@+id/w_temporizador" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/wf_pastilla" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:textColor="#FFFEF1D5" android:textSize="12sp" android:textStyle="bold" android:visibility="gone" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
      <ImageButton android:id="@+id/w_lista" android:layout_width="36dp" android:layout_height="44dp" android:background="@android:color/transparent" android:padding="7dp" android:scaleType="fitCenter" android:src="@drawable/wi_lista" android:tint="#FFA9C3D6" android:contentDescription="Guardar en una lista" />
      <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
      <ImageButton android:id="@+id/w_anterior" android:layout_width="36dp" android:layout_height="44dp" android:background="@android:color/transparent" android:padding="7dp" android:scaleType="fitCenter" android:src="@drawable/wi_anterior" android:tint="#FFFEF1D5" android:contentDescription="Anterior" />
      <ImageButton android:id="@+id/w_alternar" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/wc_rojo" android:padding="13dp" android:scaleType="fitCenter" android:src="@drawable/wi_play" android:tint="#FFFFFFFF" android:contentDescription="Reproducir o pausar" />
      <ImageButton android:id="@+id/w_siguiente" android:layout_width="36dp" android:layout_height="44dp" android:background="@android:color/transparent" android:padding="7dp" android:scaleType="fitCenter" android:src="@drawable/wi_siguiente" android:tint="#FFFEF1D5" android:contentDescription="Siguiente" />
      <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
      <ImageButton android:id="@+id/w_dormir" android:layout_width="36dp" android:layout_height="44dp" android:background="@android:color/transparent" android:padding="7dp" android:scaleType="fitCenter" android:src="@drawable/wi_luna" android:tint="#FFA9C3D6" android:contentDescription="Temporizador para dormir" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
