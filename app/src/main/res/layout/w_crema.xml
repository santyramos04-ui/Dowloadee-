<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_raiz" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/wf_crema">
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="6dp">
    <include layout="@layout/w_rac" android:layout_width="56dp" android:layout_height="56dp"  />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="vertical">
      <TextView android:id="@+id/w_titulo" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FF0C324A" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text="Nada sonando"  />
      <TextView android:id="@+id/w_autor" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FF2F5670" android:textSize="13sp"  android:maxLines="1" android:ellipsize="end" android:text="Toca para abrir RACQ"  />
    </LinearLayout>
    <ImageButton android:id="@+id/w_anterior" android:layout_width="40dp" android:layout_height="44dp" android:background="@android:color/transparent" android:padding="9dp" android:scaleType="fitCenter" android:src="@drawable/wi_anterior" android:tint="#FF0C324A" android:contentDescription="Anterior" />
    <ImageButton android:id="@+id/w_alternar" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/wc_rojo" android:padding="13dp" android:scaleType="fitCenter" android:src="@drawable/wi_play" android:tint="#FFFFFFFF" android:contentDescription="Reproducir o pausar" />
    <ImageButton android:id="@+id/w_siguiente" android:layout_width="40dp" android:layout_height="44dp" android:background="@android:color/transparent" android:padding="9dp" android:scaleType="fitCenter" android:src="@drawable/wi_siguiente" android:tint="#FF0C324A" android:contentDescription="Siguiente" />
  </LinearLayout>
  
</FrameLayout>
