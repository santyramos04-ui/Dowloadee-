<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_raiz" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/wf_marina" android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="8dp" android:paddingTop="6dp" android:paddingBottom="14dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:orientation="horizontal">
    <include layout="@layout/w_rac" android:layout_width="32dp" android:layout_height="32dp"  />
    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Para ti" android:textColor="#FFFEF1D5" android:textSize="16sp" android:textStyle="bold" />
    <ImageButton android:id="@+id/w_otras" android:layout_width="44dp" android:layout_height="44dp" android:background="@android:color/transparent" android:padding="12dp" android:scaleType="fitCenter" android:src="@drawable/wi_refrescar" android:tint="#FFA9C3D6" android:contentDescription="Otras recomendaciones" />
  </LinearLayout>
  <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingEnd="6dp">
    <LinearLayout android:id="@+id/w_recs" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
      <LinearLayout android:id="@+id/w_rec0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="0dp" android:orientation="vertical">
      <ImageView android:id="@+id/w_rec0_img" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scaleType="centerCrop" android:background="@drawable/wf_miniatura" android:importantForAccessibility="no" />
      <TextView android:id="@+id/w_rec0_titulo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#FFFEF1D5" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
      <LinearLayout android:id="@+id/w_rec1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="vertical">
      <ImageView android:id="@+id/w_rec1_img" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scaleType="centerCrop" android:background="@drawable/wf_miniatura" android:importantForAccessibility="no" />
      <TextView android:id="@+id/w_rec1_titulo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#FFFEF1D5" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
      <LinearLayout android:id="@+id/w_rec2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="vertical">
      <ImageView android:id="@+id/w_rec2_img" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scaleType="centerCrop" android:background="@drawable/wf_miniatura" android:importantForAccessibility="no" />
      <TextView android:id="@+id/w_rec2_titulo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#FFFEF1D5" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
      <LinearLayout android:id="@+id/w_rec3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="vertical">
      <ImageView android:id="@+id/w_rec3_img" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scaleType="centerCrop" android:background="@drawable/wf_miniatura" android:importantForAccessibility="no" />
      <TextView android:id="@+id/w_rec3_titulo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#FFFEF1D5" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/w_vacia" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="Abre RACQ y mira algo: aquí saldrán tus recomendaciones." android:textColor="#FFA9C3D6" android:textSize="13sp" android:visibility="gone" />
  </FrameLayout>
</LinearLayout>
