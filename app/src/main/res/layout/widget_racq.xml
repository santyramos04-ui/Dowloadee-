<?xml version="1.0" encoding="utf-8"?>
<!-- Widget de RACQ: lo que suena y los botones anterior / reproducir-pausar / siguiente. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/w_logo"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_mark" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/w_titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFEF1D5"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_autor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFA9C3D6"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/w_anterior"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@android:color/transparent"
        android:contentDescription="Anterior"
        android:src="@drawable/ic_w_prev" />

    <ImageButton
        android:id="@+id/w_alternar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:contentDescription="Reproducir o pausar"
        android:src="@drawable/ic_w_play" />

    <ImageButton
        android:id="@+id/w_siguiente"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@android:color/transparent"
        android:contentDescription="Siguiente"
        android:src="@drawable/ic_w_next" />
</LinearLayout>
