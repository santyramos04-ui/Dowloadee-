{
  "permissions": {
    "deny": [
      "Read(./secrets/**)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./**/.env*)",
      "Read(./**/*.pem)",
      "Read(./**/*.p12)"
    ]
  },
  "extraKnownMarketplaces": {
    "brag": {
      "source": {
        "source": "github",
        "repo": "latent-spaces/brag"
      }
    }
  },
  "enabledPlugins": {
    "brag@brag": true
  }
}
